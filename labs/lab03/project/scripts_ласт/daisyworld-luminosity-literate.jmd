# # Динамика модели Daisyworld при изменении светимости
#
# **Цель:** Исследовать, как изменение солнечной светимости влияет на численность маргариток и температуру планеты.
#
# ## Инициализация
using DrWatson
@quickactivate "project"
using Agents
using DataFrames
using Plots
using CairoMakie
using StatsBase

include(srcdir("daisyworld.jl"))

# ## Функции для подсчёта
black(a) = a.breed == :black
white(a) = a.breed == :white
adata = [(black, count), (white, count)]

# ## Функция для средней температуры
temperature(model) = StatsBase.mean(model.temperature)
mdata = [temperature, :solar_luminosity]

# ## Запуск модели со сценарием изменения светимости
model = daisyworld(scenario = :ramp)
agent_df, model_df = run!(model, 1000; adata, mdata)

# ## Визуализация
figure = CairoMakie.Figure(size = (600, 600))

# График численности маргариток
ax1 = figure[1, 1] = Axis(figure, ylabel = "daisy count")
black1 = lines!(ax1, agent_df[!, :time], agent_df[!, :count_black], color = :red)
white1 = lines!(ax1, agent_df[!, :time], agent_df[!, :count_white], color = :blue)
figure[1, 2] = Legend(figure, [black1, white1], ["black", "white"])

# График температуры
ax2 = figure[2, 1] = Axis(figure, ylabel = "temperature")
# График светимости
ax3 = figure[3, 1] = Axis(figure, xlabel = "tick", ylabel = "luminosity")

lines!(ax2, model_df[!, :time], model_df[!, :temperature], color = :red)
lines!(ax3, model_df[!, :time], model_df[!, :solar_luminosity], color = :red)

# Скрываем подписи по оси X для верхних графиков
for ax in (ax1, ax2)
    ax.xticklabelsvisible = false
end

# ## Сохранение графика
save(plotsdir("daisy_luminosity.png"), figure)
