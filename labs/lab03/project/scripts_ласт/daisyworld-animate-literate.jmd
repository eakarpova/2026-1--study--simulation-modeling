# # Анимация модели Daisyworld
#
# **Цель:** Создать видео эволюции модели Daisyworld, показывающее динамику изменения температуры и распределения маргариток.
#
# ## Инициализация
using DrWatson
@quickactivate "project"
using Agents
using DataFrames
using Plots
using CairoMakie

include(srcdir("daisyworld.jl"))

# ## Создание модели
model = daisyworld()

# ## Функция для цвета маргариток
daisycolor(a::Daisy) = a.breed

# ## Параметры визуализации
plotkwargs = (
    agent_color = daisycolor,
    agent_size = 20,
    agent_marker = '✿',
    heatarray = :temperature,
    heatkwargs = (colorrange = (-20, 60),)
)

# ## Генерация видео
abmvideo(plotsdir("simulation.mp4"), model;
         title = "Daisy World",
         frames = 60,
         plotkwargs...)
